---
import Mascot from './Mascot.astro';
import { profile, stats } from '../data/site';
import type { CastName } from '../lib/cast';

const steps: { who: CastName; tag: string; text: string; ms: string; mood: 'think' | 'search' | 'wow' | 'happy' }[] = [
  { who: 'tok', tag: 'intent', text: 'access_request detected · confidence 0.98', ms: '90ms', mood: 'think' },
  { who: 'pix', tag: 'context', text: 'permissions, record &amp; field-level security loaded', ms: '210ms', mood: 'search' },
  { who: 'bolt', tag: 'tools', text: 'run_flow(grant_report_access) · admins emailed', ms: '1.1s', mood: 'wow' },
  { who: 'dot', tag: 'guardrail', text: 'scope check · no invented fields <span class="ok">✓ pass</span>', ms: '140ms', mood: 'happy' },
];
---
<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="intro">
      <span class="status"><span class="pulse" aria-hidden="true"></span><span class="city">{profile.location.split(",")[0]} · </span>{profile.availability}</span>
      <h1>I build agentic AI systems that hold up in <span class="serif">production.</span></h1>
      <p class="lede">
        <b>{profile.role}</b> at <b>{profile.company}</b>. I take agentic systems from proof of concept to rollout:
        multi-agent orchestration, LLMs grounded in live enterprise data, and guardrails that keep them honest.
      </p>
      <div class="ctas">
        <a href="#work" class="btn btn-primary">See selected work <span class="arrow">→</span></a>
        <button class="btn btn-ghost" data-copy-email>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          Copy email
        </button>
      </div>
    </div>

    <figure class="trace" aria-label="Animated example: an agent resolving a Salesforce access request">
      <div class="trace-head">
        <div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
        <span>copilot · live run</span>
        <span id="runId">run_7f3a</span>
      </div>
      <div class="cast-row">
        {steps.map((s) => (
          <div class="slot" data-who={s.who}>
            <Mascot name={s.who} />
            <span>{s.tag}</span>
          </div>
        ))}
      </div>
      <div class="trace-body" aria-hidden="true">
        <div class="t-query">▸ user: <b>"Give Priya edit access to the APAC renewals report"</b></div>
        {steps.map((s) => (
          <div class="t-line" data-mood={s.mood}>
            <span class="t-tag">[{s.tag}]</span><span set:html={s.text} /><span class="t-time">{s.ms}</span>
          </div>
        ))}
        <div class="t-line t-final">
          <span><span class="ok">✓</span> resolved in chat · no ticket raised <span class="caret"></span></span>
          <span class="t-time">1.6s</span>
        </div>
      </div>
    </figure>
  </div>

  <div class="wrap">
    <dl class="stats" data-reveal>
      {stats.map((s) => (
        <div class="stat">
          <dt class="sr-only">{s.label}</dt>
          <dd class="n">{s.value}<sup>{s.suffix}</sup></dd>
          <dd class="l" aria-hidden="true">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</header>

<style>
  .hero { padding: 40px 0 0; }
  @media (min-width: 768px) { .hero { padding: 128px 0 0; } }
  .hero-grid { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; } }

  .status {
    display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 11px; max-width: 100%;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
    font: 500 12.5px var(--mono); color: var(--ink-2);
  }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); position: relative; flex: none; }
  @media (max-width: 420px) { .city { display: none; } }
  .pulse::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--ok); opacity: 0; animation: ping 2s ease-out infinite; }
  @keyframes ping { 0% { transform: scale(.5); opacity: .8; } 100% { transform: scale(1.6); opacity: 0; } }
  h1 { font-size: clamp(38px, 7vw, 74px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 600; margin: 22px 0; text-wrap: balance; }
  h1 .serif { font-size: 1.08em; letter-spacing: -0.01em; color: var(--accent); }
  .lede { font-size: clamp(17px, 2vw, 19px); color: var(--ink-2); max-width: 34em; text-wrap: pretty; }
  .lede b { color: var(--ink); font-weight: 500; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  /* Trace */
  .trace { background: var(--trace-bg); color: var(--trace-ink); border-radius: 22px; border: 1px solid var(--trace-line); overflow: hidden; box-shadow: 0 30px 60px -30px rgb(0 0 0 / .45); }
  .trace-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--trace-line); font: 500 12px var(--mono); color: var(--trace-dim); }
  .lights { display: flex; gap: 6px; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: #3A3934; }
  .cast-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: 16px 10px 4px; border-bottom: 1px solid var(--trace-line); }
  .slot { display: flex; flex-direction: column; align-items: center; gap: 2px; padding-bottom: 12px; position: relative; }
  .slot :global(.mascot) { width: clamp(58px, 15vw, 88px); color: var(--trace-dim); transition: transform .4s var(--ease-spring), opacity .3s, filter .3s; opacity: .4; filter: grayscale(.85); }
  .slot span { font: 500 11px var(--mono); color: var(--trace-dim); transition: color .3s; }
  .slot.active :global(.mascot) { opacity: 1; filter: none; transform: translateY(-6px) scale(1.08); }
  .slot.active span { color: var(--accent); }
  .slot.done :global(.mascot) { opacity: .95; filter: none; }
  .slot::after { content: ""; position: absolute; bottom: -1px; left: 22%; right: 22%; height: 2px; background: var(--accent); transform: scaleX(0); transition: transform .4s; }
  .slot.active::after { transform: scaleX(1); }

  .trace-body { padding: 16px 18px 20px; font: 400 13px/1.6 var(--mono); min-height: 244px; }
  .t-query { color: var(--trace-dim); margin-bottom: 12px; }
  .t-query b { color: var(--trace-ink); font-weight: 500; }
  .t-line { display: grid; grid-template-columns: 92px 1fr auto; gap: 10px; padding: 5px 0; opacity: 0; transform: translateY(4px); transition: opacity .35s, transform .35s; }
  .t-line.show { opacity: 1; transform: none; }
  .t-tag { color: var(--accent); }
  .t-time { color: var(--trace-dim); }
  .trace :global(.ok) { color: #4CC27E; }
  .t-final { margin-top: 10px; padding-top: 12px; border-top: 1px dashed var(--trace-line); grid-template-columns: 1fr auto; }
  .caret { display: inline-block; width: 7px; height: 14px; background: var(--accent); vertical-align: -2px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 420px) {
    .t-line { grid-template-columns: 84px 1fr; } .t-line .t-time { display: none; }
    .trace-body { font-size: 12.5px; padding: 14px 14px 18px; }
  }

  /* Stats */
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-top: 64px; }
  @media (min-width: 768px) { .stats { grid-template-columns: repeat(4, 1fr); margin-top: 88px; } }
  .stat { padding: 24px 4px 24px 0; }
  .stat + .stat { padding-left: 20px; border-left: 1px solid var(--line); }
  @media (max-width: 767px) { .stat:nth-child(3) { border-left: 0; padding-left: 0; } .stat:nth-child(n+3) { border-top: 1px solid var(--line); } }
  .n { font-size: clamp(34px, 5vw, 48px); font-weight: 600; letter-spacing: -.03em; line-height: 1; }
  .n sup { font-size: .5em; color: var(--accent); vertical-align: top; margin-left: 2px; }
  .l { font: 500 12px var(--mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; margin-top: 10px; }
</style>

<script>
  import { hop, reduceMotion } from '../scripts/global';

  const slots = [...document.querySelectorAll<HTMLElement>('.cast-row .slot')];
  const lines = [...document.querySelectorAll<HTMLElement>('.trace-body .t-line')];
  const runId = document.getElementById('runId')!;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const mascotOf = (s: HTMLElement) => s.querySelector<HTMLElement>('.mascot')!;

  let visible = true;
  new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(document.querySelector('.trace')!);

  async function loop() {
    if (reduceMotion()) {
      lines.forEach((l) => l.classList.add('show'));
      slots.forEach((s) => s.classList.add('done'));
      return;
    }
    while (true) {
      while (!visible) await wait(400); // pause off-screen
      lines.forEach((l) => l.classList.remove('show'));
      slots.forEach((s) => { s.classList.remove('active', 'done'); delete mascotOf(s).dataset.mood; });
      runId.textContent = 'run_' + Math.random().toString(16).slice(2, 6);
      await wait(800);
      for (let i = 0; i < slots.length; i++) {
        const m = mascotOf(slots[i]);
        slots[i].classList.add('active');
        m.dataset.mood = lines[i].dataset.mood!;
        if (i === slots.length - 1) hop(m);
        await wait(1000);
        lines[i].classList.add('show');
        await wait(600);
        slots[i].classList.replace('active', 'done');
        if (i < slots.length - 1) delete m.dataset.mood;
      }
      lines[lines.length - 1].classList.add('show');
      await wait(4000);
    }
  }
  loop();
</script>
