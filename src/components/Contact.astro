---
import { Image } from 'astro:assets';
import Mascot from './Mascot.astro';
import portrait from '../assets/portrait.png';
import { profile } from '../data/site';

const links = [
  { label: 'LinkedIn', value: 'in/tharunkumar0409', href: profile.linkedin },
  { label: 'GitHub', value: 'tkm0409', href: profile.github },
  { label: 'WhatsApp', value: profile.phoneDisplay, href: profile.whatsapp },
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
];
---
<section class="block" id="contact">
  <div class="wrap grid">
    <div class="about" data-reveal>
      <div class="eyebrow">About</div>
      <div class="portrait">
        <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[240, 400, 560]} sizes="(min-width: 900px) 240px, 50vw" loading="lazy" />
      </div>
      <div class="story">
        {profile.story.map((p) => <p>{p}</p>)}
      </div>
      <dl class="facts">
        <div><dt>Based in</dt><dd>{profile.location}</dd></div>
        <div><dt>Speaks</dt><dd>{profile.languages.join(', ')}</dd></div>
      </dl>
    </div>

    <div class="cta" data-reveal>
      <Mascot name="ping" class="ping" />
      <div class="eyebrow">Contact</div>
      <h2>Let's build something that <span class="serif">ships.</span></h2>
      <p class="sub"><span class="pulse" aria-hidden="true"></span>{profile.availability}. Usually replies within a day.</p>
      <button class="big-email" data-copy-email>
        <span class="addr">{profile.email}</span>
        <span class="copy">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          Copy
        </span>
      </button>
      <ul class="links">
        {links.map((l) => (
          <li>
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
              <span class="k">{l.label}</span><span class="v">{l.value}</span><span class="arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 64px; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1fr 1.15fr; gap: 72px; align-items: start; } }

  .portrait { width: min(56%, 240px); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--stage); margin: 18px 0 24px; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .story { display: grid; gap: 14px; color: var(--ink-2); font-size: 16.5px; max-width: 36em; }
  .story p { text-wrap: pretty; }
  .story p:first-child { color: var(--ink); font-size: 18px; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--line); }
  dt { font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin-bottom: 4px; }
  dd { font-size: 15px; }

  .cta { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: 28px 20px 24px; }
  @media (min-width: 640px) { .cta { padding: 40px 36px 32px; } }
  .ping { position: absolute; width: 92px; top: -46px; right: 18px; }
  @media (min-width: 640px) { .ping { width: 120px; top: -60px; right: 28px; } }
  .cta h2 { margin-bottom: 14px; padding-right: 40px; }
  .sub { display: flex; align-items: center; gap: 10px; color: var(--ink-2); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); flex: none; box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent); }

  .big-email {
    width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 26px 0 8px;
    padding: 16px 16px 16px 20px; border-radius: 16px; background: var(--ink); color: var(--bg); text-align: left;
    transition: background .2s, color .2s, transform .2s var(--ease-out);
  }
  .big-email:active { transform: scale(.98); }
  @media (hover: hover) { .big-email:hover { background: var(--accent); color: var(--on-accent); } }
  .addr { font-size: clamp(15px, 2.4vw, 20px); font-weight: 500; letter-spacing: -.01em; overflow-wrap: anywhere; min-width: 0; }
  .copy { display: inline-flex; align-items: center; gap: 6px; font: 500 13px var(--mono); padding: 8px 12px; border-radius: 10px; background: color-mix(in srgb, var(--bg) 14%, transparent); flex: none; }

  .links { list-style: none; margin-top: 14px; }
  .links a { display: grid; grid-template-columns: 96px 1fr auto; gap: 12px; align-items: center; padding: 14px 4px; border-bottom: 1px solid var(--line); }
  .links li:last-child a { border-bottom: 0; }
  .k { font: 500 12px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); }
  .v { overflow-wrap: anywhere; min-width: 0; transition: color .2s; }
  .arr { color: var(--ink-3); transition: transform .25s var(--ease-out), color .2s; }
  @media (hover: hover) { .links a:hover .v, .links a:hover .arr { color: var(--accent); } .links a:hover .arr { transform: translate(2px, -2px); } }
</style>
