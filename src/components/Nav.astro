---
import Mascot from './Mascot.astro';
import { profile, sections } from '../data/site';
import { CAST } from '../lib/cast';
const desktopLinks = sections.filter((s) => s.id !== 'certifications');
---
<nav class="nav" id="nav" aria-label="Primary">
  <a href="#top" class="logo" aria-label={`${profile.name}, back to top`}>
    <span class="dot">{profile.initials}</span><span class="logo-name">{profile.shortName}</span>
  </a>
  <div class="links">
    {desktopLinks.map((s) => <a href={`#${s.id}`} data-nav={s.id}>{s.label}</a>)}
  </div>
  <button class="icon-btn" data-theme-toggle aria-label="Toggle light or dark theme">
    <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <button class="kbd" data-open-palette aria-label="Open command menu"><span class="kbd-mod">⌘</span>K</button>
  <button class="menu-btn" id="menuBtn" aria-haspopup="dialog" aria-controls="sheet">
    Menu
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
  </button>
</nav>

<dialog class="sheet" id="sheet" aria-label="Site menu">
  <div class="sheet-inner">
    <div class="grab" aria-hidden="true"></div>
    <div class="sheet-head">
      <span class="eyebrow">Jump to</span>
      <button class="icon-btn" data-close aria-label="Close menu">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <ul class="sheet-links">
      {sections.map((s) => (
        <li>
          <a href={`#${s.id}`} data-close>
            <Mascot name={s.host} />
            <span><b>{s.label}</b><small>with {CAST[s.host].name}</small></span>
            <svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </a>
        </li>
      ))}
    </ul>
    <div class="sheet-actions">
      <button class="btn btn-primary" data-copy-email data-close>Copy email</button>
      <button class="btn btn-ghost" data-theme-toggle>Switch theme</button>
    </div>
  </div>
</dialog>

<style>
  .nav {
    position: fixed; z-index: 50; left: 12px;
    bottom: max(12px, env(safe-area-inset-bottom));
    display: flex; align-items: center; gap: 4px; padding: 6px;
    background: color-mix(in srgb, var(--surface) 84%, transparent);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--line); border-radius: 999px;
    box-shadow: 0 8px 30px -12px rgb(0 0 0 / .22);
  }
  @media (min-width: 768px) { .nav { top: 16px; bottom: auto; left: 50%; transform: translateX(-50%); } }
  .logo { display: flex; align-items: center; gap: 8px; padding: 0 12px 0 6px; font-weight: 600; letter-spacing: -.01em; white-space: nowrap; }
  .logo .dot { width: 28px; height: 28px; border-radius: 50%; background: var(--ink); color: var(--bg); display: grid; place-items: center; font: 600 12px var(--mono); }
  .links { display: none; }
  @media (min-width: 768px) { .links { display: flex; gap: 2px; } }
  .links a { padding: 8px 11px; border-radius: 999px; font-size: 14px; color: var(--ink-2); transition: background .2s, color .2s; white-space: nowrap; }
  @media (min-width: 1024px) { .links a { padding: 8px 14px; } }
  .links a.active, .links a:hover { background: var(--surface-2); color: var(--ink); }
  .icon-btn { width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center; color: var(--ink-2); transition: background .2s, color .2s; flex: none; }
  .icon-btn:hover { background: var(--surface-2); color: var(--ink); }
  .ico-sun { display: none; }
  :global([data-theme="dark"]) .ico-sun { display: block; }
  :global([data-theme="dark"]) .ico-moon { display: none; }
  .kbd { display: none; white-space: nowrap; font: 500 12px var(--mono); color: var(--ink-3); border: 1px solid var(--line); border-radius: 9px; padding: 7px 10px; margin-left: 2px; transition: color .2s, border-color .2s; }
  .kbd:hover { color: var(--ink); border-color: var(--ink-3); }
  @media (min-width: 1024px) and (hover: hover) { .kbd { display: inline-block; } }
  .menu-btn { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 999px; background: var(--ink); color: var(--bg); font-size: 14px; font-weight: 500; }
  @media (min-width: 768px) { .menu-btn { display: none; } }

  /* Bottom sheet (phones) */
  .sheet {
    margin: auto auto 0; width: 100%; max-width: 520px; max-height: 88dvh; border: 0; padding: 0;
    background: var(--surface); color: var(--ink); border-radius: 24px 24px 0 0;
    box-shadow: 0 -20px 60px -20px rgb(0 0 0 / .4);
  }
  .sheet::backdrop { background: rgb(0 0 0 / .4); backdrop-filter: blur(2px); }
  .sheet[open] { animation: sheet-up .4s var(--ease-out); }
  .sheet[open]::backdrop { animation: fade .3s; }
  @keyframes sheet-up { from { transform: translateY(100%); } }
  @keyframes fade { from { opacity: 0; } }
  .sheet-inner { padding: 10px 16px calc(18px + env(safe-area-inset-bottom)); }
  .grab { width: 40px; height: 4px; border-radius: 4px; background: var(--line); margin: 0 auto 8px; }
  .sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 0 4px 6px; }
  .sheet-links { list-style: none; }
  .sheet-links a { display: grid; grid-template-columns: 44px 1fr 16px; align-items: center; gap: 14px; padding: 8px 6px; border-radius: 14px; }
  .sheet-links a:active { background: var(--surface-2); }
  .sheet-links :global(.mascot) { width: 44px; }
  .sheet-links b { display: block; font-weight: 500; font-size: 17px; }
  .sheet-links small { font: 500 12px var(--mono); color: var(--ink-3); }
  .chev { color: var(--ink-3); }
  .sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const sheet = document.getElementById('sheet') as HTMLDialogElement;
  document.getElementById('menuBtn')!.addEventListener('click', () => sheet.showModal());
  sheet.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t === sheet || t.closest('[data-close]')) sheet.close();
  });

  // Highlight the section in view
  const links = new Map([...nav.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav!, a]));
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.remove('active'));
      links.get(e.target.id)?.classList.add('active');
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('main section[id], main header[id]').forEach((s) => io.observe(s));

  // Show the right modifier key
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('.kbd-mod').forEach((el) => (el.textContent = 'Ctrl '));
  }
</script>
