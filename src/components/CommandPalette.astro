---
import { profile, sections } from '../data/site';

type Cmd = { label: string; hint: string; action: string; value: string };
const cmds: Cmd[] = [
  ...sections.map((s) => ({ label: `Go to ${s.label}`, hint: 'Section', action: 'go', value: s.id })),
  { label: 'Copy email address', hint: 'Contact', action: 'copy', value: '' },
  { label: 'Open LinkedIn', hint: 'Link', action: 'open', value: profile.linkedin },
  { label: 'Open GitHub', hint: 'Link', action: 'open', value: profile.github },
  { label: 'Message on WhatsApp', hint: 'Link', action: 'open', value: profile.whatsapp },
  { label: 'Toggle light / dark theme', hint: 'Theme', action: 'theme', value: '' },
  { label: 'Back to top', hint: 'Section', action: 'go', value: 'top' },
];
---
<dialog class="palette" id="palette" aria-label="Command menu">
  <div class="field">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input id="paletteInput" type="text" placeholder="Type a command or section…" autocomplete="off" spellcheck="false"
      role="combobox" aria-expanded="true" aria-controls="paletteList" aria-autocomplete="list" />
    <kbd>esc</kbd>
  </div>
  <ul id="paletteList" role="listbox">
    {cmds.map((c) => (
      <li role="option" data-action={c.action} data-value={c.value} data-label={c.label.toLowerCase()} aria-selected="false">
        <span>{c.label}</span><small>{c.hint}</small>
      </li>
    ))}
  </ul>
  <p class="empty" hidden>Nothing matches. Even Pix couldn't find it.</p>
</dialog>

<style>
  .palette {
    margin: 12vh auto auto; width: calc(100% - 32px); max-width: 560px; border: 1px solid var(--line); padding: 0;
    background: var(--surface); color: var(--ink); border-radius: 18px; box-shadow: 0 30px 80px -20px rgb(0 0 0 / .45);
  }
  .palette::backdrop { background: rgb(0 0 0 / .35); backdrop-filter: blur(3px); }
  .palette[open] { animation: pop .25s var(--ease-out); }
  @keyframes pop { from { opacity: 0; transform: scale(.97) translateY(-6px); } }
  .field { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--ink-3); }
  input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--ink); font: 400 16px var(--sans); }
  kbd { font: 500 11px var(--mono); border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; }
  ul { list-style: none; padding: 8px; max-height: min(52vh, 420px); overflow: auto; }
  li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 11px 12px; border-radius: 10px; cursor: pointer; font-size: 15px; }
  li small { font: 500 11px var(--mono); color: var(--ink-3); text-transform: uppercase; letter-spacing: .06em; }
  li[aria-selected="true"] { background: var(--surface-2); }
  li[aria-selected="true"] span::before { content: "→ "; color: var(--accent); }
  .empty { padding: 20px 20px 24px; color: var(--ink-3); font-size: 14px; }
</style>

<script>
  import { copyEmail, toggleTheme } from '../scripts/global';

  const dlg = document.getElementById('palette') as HTMLDialogElement;
  const input = document.getElementById('paletteInput') as HTMLInputElement;
  const items = [...dlg.querySelectorAll<HTMLLIElement>('li')];
  const empty = dlg.querySelector<HTMLElement>('.empty')!;
  let active = 0;

  const visible = () => items.filter((i) => !i.hidden);
  function select(n: number) {
    const v = visible();
    if (!v.length) return;
    active = (n + v.length) % v.length;
    items.forEach((i) => i.setAttribute('aria-selected', 'false'));
    v[active].setAttribute('aria-selected', 'true');
    v[active].scrollIntoView({ block: 'nearest' });
  }
  function open() {
    input.value = '';
    items.forEach((i) => (i.hidden = false));
    empty.hidden = true;
    dlg.showModal();
    input.focus();
    select(0);
  }
  function run(li: HTMLLIElement) {
    dlg.close();
    const { action, value } = li.dataset;
    if (action === 'go') document.getElementById(value!)?.scrollIntoView({ behavior: 'smooth' });
    else if (action === 'open') window.open(value, '_blank', 'noopener');
    else if (action === 'copy') copyEmail();
    else if (action === 'theme') toggleTheme();
  }

  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open(); }
  });
  document.querySelectorAll('[data-open-palette]').forEach((b) => b.addEventListener('click', open));

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    items.forEach((i) => (i.hidden = !!q && !i.dataset.label!.includes(q)));
    empty.hidden = visible().length > 0;
    select(0);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(active - 1); }
    else if (e.key === 'Enter') { e.preventDefault(); const v = visible()[active]; if (v) run(v); }
  });
  items.forEach((li) => {
    li.addEventListener('click', () => run(li));
    li.addEventListener('pointermove', () => select(visible().indexOf(li)));
  });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
