---
import { Image, getImage } from 'astro:assets';
import { awards, moments } from '../data/site';

// Large versions for the lightbox
const gallery = await Promise.all(
  [...awards.map((a) => ({ caption: `${a.title} · ${a.when}`, image: a.image })), ...moments].map(async (g) => ({
    caption: g.caption,
    src: (await getImage({ src: g.image, width: 1600, format: 'webp' })).src,
  })),
);
---
<section class="block" id="recognition">
  <div class="wrap">
    <div class="sec-head" data-reveal>
      <div>
        <div class="eyebrow">Recognition</div>
        <h2>A few things worth <span class="serif">framing.</span></h2>
      </div>
      <p>Hackathon podiums, performance awards and the people behind them. Tap any photo to see it up close.</p>
    </div>
  </div>

  <div class="rail-wrap">
    <ul class="awards wrap" aria-label="Awards">
      {awards.map((a, i) => (
        <li class:list={['award', { featured: a.featured }]} data-reveal>
          <button class="shot" data-open={i} aria-label={`View photo: ${a.title}`}>
            <Image src={a.image} alt="" widths={[360, 560, 800]} sizes="(min-width: 1100px) 300px, (min-width: 700px) 45vw, 78vw" loading="lazy" />
          </button>
          <div class="meta">
            <span class="kind">{a.tag}</span>
            <span class="when">{a.when}</span>
          </div>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </li>
      ))}
    </ul>
  </div>

  <div class="wrap">
    <div class="moments-head" data-reveal>
      <div>
        <span class="eyebrow">Moments</span>
        <h3>Behind the trophies</h3>
      </div>
      <button class="gallery-btn" data-open={awards.length}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        View all {moments.length}
      </button>
    </div>
    <ul class="bento" aria-label="Photos from events">
      {moments.map((m, i) => (
        <li class={`tile t-${'abcdefg'[i]}`} data-reveal>
          <button class="tile-btn" data-open={awards.length + i} aria-label={`View photo: ${m.caption}`}>
            <Image
              src={m.image}
              alt=""
              widths={i === 0 ? [480, 800, 1100] : [360, 560, 800]}
              sizes={i === 0 || i === 5 ? '(min-width: 1024px) 560px, 92vw' : '(min-width: 1024px) 280px, 46vw'}
              loading="lazy"
            />
            <span class="cap">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="txt">{m.caption}</span>
              <span class="zoom" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <figure>
    <img id="lbImg" alt="" />
    <figcaption><span id="lbCap"></span><span id="lbCount" class="count"></span></figcaption>
  </figure>
  <button class="lb-btn close" data-lb="close" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button class="lb-btn prev" data-lb="prev" aria-label="Previous photo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
  </button>
  <button class="lb-btn next" data-lb="next" aria-label="Next photo">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
  </button>
</dialog>
<script type="application/json" id="galleryData" set:html={JSON.stringify(gallery)} />

<style>
  /* Awards: swipeable rail on phones, grid from tablet up */
  .awards {
    list-style: none; display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 320px); gap: 14px;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 16px; padding-bottom: 8px; scrollbar-width: none;
  }
  .awards::-webkit-scrollbar { display: none; }
  .award { scroll-snap-align: start; }
  @media (min-width: 700px) {
    .awards { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); grid-auto-columns: auto; overflow: visible; gap: 32px 20px; }
  }
  @media (min-width: 1100px) { .awards { grid-template-columns: repeat(4, 1fr); } }

  .shot { display: block; width: 100%; border-radius: 14px; overflow: hidden; background: var(--surface-2); position: relative; cursor: zoom-in; }
  .shot :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .6s var(--ease-out), filter .3s; }
  @media (hover: hover) { .shot:hover :global(img) { transform: scale(1.04); } }
  .featured .shot::after { content: "★ Featured"; position: absolute; top: 10px; left: 10px; font: 500 11px var(--mono); padding: 4px 9px; border-radius: 999px; background: var(--accent); color: var(--on-accent); }
  .meta { display: flex; justify-content: space-between; gap: 8px; margin: 14px 0 6px; font: 500 12px var(--mono); }
  .kind { color: var(--accent); text-transform: uppercase; letter-spacing: .06em; }
  .when { color: var(--ink-3); }
  .award h3 { font-size: 19px; font-weight: 600; letter-spacing: -.02em; line-height: 1.25; margin-bottom: 6px; }
  .award p { font-size: 14px; color: var(--ink-2); text-wrap: pretty; }

  /* Moments: bento grid */
  .moments-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin: 80px 0 22px; }
  .moments-head h3 { font-size: clamp(22px, 3vw, 30px); font-weight: 600; letter-spacing: -.02em; margin-top: 8px; }
  .gallery-btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 42px; padding: 0 16px; border-radius: 999px; flex: none;
    border: 1px solid var(--line); background: var(--surface); font-size: 14px; font-weight: 500; transition: border-color .2s, color .2s;
  }
  @media (hover: hover) { .gallery-btn:hover { border-color: var(--accent); color: var(--accent); } }

  .bento {
    list-style: none; display: grid; gap: 10px;
    grid-template-columns: repeat(2, 1fr); grid-auto-rows: clamp(130px, 38vw, 220px);
    grid-template-areas: "a a" "a a" "b c" "d c" "f f" "e g";
  }
  @media (min-width: 1024px) {
    .bento {
      gap: 14px; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 230px;
      grid-template-areas: "a a b c" "a a d c" "e f f g";
    }
  }
  .t-a { grid-area: a; } .t-b { grid-area: b; } .t-c { grid-area: c; } .t-d { grid-area: d; }
  .t-e { grid-area: e; } .t-f { grid-area: f; } .t-g { grid-area: g; }

  .tile-btn { position: relative; display: block; width: 100%; height: 100%; border-radius: 16px; overflow: hidden; background: var(--surface-2); cursor: zoom-in; isolation: isolate; }
  .tile-btn :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out), filter .4s; }
  .t-c .tile-btn :global(img), .t-d .tile-btn :global(img), .t-b .tile-btn :global(img) { object-position: center 30%; }
  .tile-btn::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / .62), transparent 46%); pointer-events: none; z-index: 1; }

  .cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 12px 12px 12px 14px; color: #fff; text-align: left; }
  .idx { font: 500 11px var(--mono); opacity: .7; }
  .txt { flex: 1; min-width: 0; font-size: 14px; font-weight: 500; line-height: 1.25; text-shadow: 0 1px 8px rgb(0 0 0 / .4); }
  .t-a .txt { font-size: clamp(16px, 2vw, 20px); }
  .zoom { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; flex: none; background: rgb(255 255 255 / .18); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); transition: transform .35s var(--ease-spring), background .2s; }
  @media (max-width: 640px) { .t-b .idx, .t-c .idx, .t-d .idx, .t-e .idx, .t-g .idx, .t-b .zoom, .t-c .zoom, .t-d .zoom, .t-e .zoom, .t-g .zoom { display: none; } .txt { font-size: 13px; } }

  @media (hover: hover) {
    .bento:hover .tile-btn :global(img) { filter: saturate(.7) brightness(.85); }
    .bento .tile-btn:hover :global(img) { transform: scale(1.05); filter: none; }
    .tile-btn:hover .zoom { transform: scale(1.1) rotate(90deg); background: var(--accent); }
  }

  /* Lightbox */
  .lightbox { width: 100vw; height: 100dvh; max-width: none; max-height: none; border: 0; padding: 0; background: rgb(8 8 7 / .94); color: #EDEAE3; }
  .lightbox::backdrop { background: transparent; }
  .lightbox[open] { display: grid; place-items: center; animation: lb-in .25s ease-out; }
  @keyframes lb-in { from { opacity: 0; } }
  figure { display: grid; justify-items: center; gap: 14px; padding: 64px 16px 24px; max-width: 100%; }
  #lbImg { max-width: min(100%, 1200px); max-height: calc(100dvh - 160px); object-fit: contain; border-radius: 10px; touch-action: pan-y; user-select: none; }
  figcaption { display: flex; align-items: baseline; justify-content: center; gap: 16px; font: 500 13px var(--mono); max-width: min(100%, 1200px); text-align: center; }
  .count { color: #8E8A80; white-space: nowrap; }
  .lb-btn { position: absolute; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: rgb(255 255 255 / .1); color: #fff; transition: background .2s; }
  .lb-btn:hover { background: rgb(255 255 255 / .2); }
  .close { top: 14px; right: 14px; }
  .prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .next { right: 14px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) { .prev, .next { top: auto; bottom: 18px; transform: none; } .prev { left: calc(50% - 60px); } .next { right: calc(50% - 60px); } figure { padding-bottom: 84px; } }
</style>

<script>
  const data: { caption: string; src: string }[] = JSON.parse(document.getElementById('galleryData')!.textContent!);
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lbImg') as HTMLImageElement;
  const cap = document.getElementById('lbCap')!;
  const count = document.getElementById('lbCount')!;
  let i = 0;

  function show(n: number) {
    i = (n + data.length) % data.length;
    img.src = data[i].src;
    img.alt = data[i].caption;
    cap.textContent = data[i].caption;
    count.textContent = `${i + 1} / ${data.length}`;
    // Warm up the neighbours
    [i + 1, i - 1].forEach((k) => { const p = new Image(); p.src = data[(k + data.length) % data.length].src; });
  }
  document.querySelectorAll<HTMLButtonElement>('#recognition [data-open]').forEach((b) =>
    b.addEventListener('click', () => { show(Number(b.dataset.open)); dlg.showModal(); }),
  );
  dlg.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const act = t.closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (act === 'close' || t === dlg || t.tagName === 'FIGURE') dlg.close();
    else if (act === 'prev') show(i - 1);
    else if (act === 'next') show(i + 1);
  });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(i - 1);
    if (e.key === 'ArrowRight') show(i + 1);
  });
  // Swipe
  let x0: number | null = null;
  img.addEventListener('pointerdown', (e) => (x0 = e.clientX));
  img.addEventListener('pointerup', (e) => {
    if (x0 === null) return;
    const dx = e.clientX - x0; x0 = null;
    if (Math.abs(dx) > 40) show(dx < 0 ? i + 1 : i - 1);
  });
</script>
